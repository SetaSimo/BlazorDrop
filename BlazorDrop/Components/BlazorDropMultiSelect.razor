@using BlazorDrop.Components.Base.Select
@using BlazorDrop.Components.Internal
@typeparam T
@inherits BaseLazyInputWithSelect<T>

<BlazorDropInputField TItem="T" Host="this" WrapperClass="bzd-multi" InputClass="bzd-multi-input" Multiselectable="true">
    <Prefix>
        @if (SelectedCount > 0)
        {
            <div class="bzd-chips" role="list">
                @foreach (var item in VisibleChips)
                {
                    var chip = item;
                    <span class="bzd-chip" role="listitem">
                        <span class="bzd-chip-label">@GetDisplayValue(chip)</span>
                        @if (!Disabled)
                        {
                            <button type="button"
                                    class="bzd-chip-remove"
                                    tabindex="-1"
                                    aria-label="@string.Format(Strings.RemoveItemFormat, GetDisplayValue(chip))"
                                    @onclick="() => RemoveAsync(chip)"
                                    @onclick:stopPropagation="true"
                                    @onmousedown:preventDefault="true">×</button>
                        }
                    </span>
                }
                @if (OverflowCount > 0)
                {
                    <span class="bzd-chip bzd-chip-overflow" role="listitem" title="@string.Format(Strings.MoreSelectedFormat, OverflowCount)">
                        <span aria-hidden="true">+@OverflowCount</span>
                        <span class="bzd-sr-only">@string.Format(Strings.MoreSelectedFormat, OverflowCount)</span>
                    </span>
                }
            </div>
        }
    </Prefix>
</BlazorDropInputField>
